# Port the game server listens on (Railway/Render/Fly inject PORT automatically).
PORT=2567
NODE_ENV=production
# Comma-separated list of browser origins allowed to call the HTTP API.
CORS_ORIGIN=https://your-game.vercel.app
# REQUIRED in production: random string, 32+ chars. Signs guest identities.
GUEST_TOKEN_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Supabase (server side only — never put the service-role key in the web app).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: where the dev file store keeps data when Supabase is not configured.
# DATA_DIR=./data
